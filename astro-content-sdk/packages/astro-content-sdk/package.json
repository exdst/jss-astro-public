{
  "name": "@exdst-sitecore-content-sdk/astro",
  "version": "0.0.25",
  "description": "Astro Content SDK for Sitecore AI (XM Cloud)",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "mocha \"./src/**/*.test.ts\" --ignore \"src/**/*.astro.test.ts\"",
    "test:components": "vitest run --config ./vitest.config.ts",
    "coverage": "nyc npm test",
    "api-extractor": "api-extractor run --local --verbose",
    "api-extractor:verify": "api-extractor run"
  },
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "EXDST",
    "url": "https://exdst.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exdst/jss-astro-public"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/exdst/jss-astro-public/issues"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.7",
    "@sitecore-content-sdk/events": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/chai": "^5.2.2",
    "@types/chai-spies": "^1.0.6",
    "@types/chai-string": "^1.4.5",
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.4",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "astro": "^6.1.3",
    "chai": "^4.4.1",
    "chai-spies": "^1.1.0",
    "chai-string": "^1.6.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "52.0.3",
    "eslint-plugin-prettier": "^4.0.0",
    "happy-dom": "^16.7.3",
    "mocha": "^11.2.2",
    "nyc": "^17.1.0",
    "prettier": "^2.8.0",
    "proxyquire": "^2.1.3",
    "sinon": "^20.0.0",
    "sinon-chai": "3.7.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^3.0.4"
  },
  "peerDependencies": {
    "@sitecore-content-sdk/analytics-core": "^2.0.1",
    "@sitecore-content-sdk/events": "^2.0.1",
    "astro": "^6.0.0"
  },
  "dependencies": {
    "@sitecore-content-sdk/content": "^2.0.1",
    "@sitecore-content-sdk/core": "^2.0.1",
    "chalk": "^4.1.2",
    "cookie": "^1.0.2",
    "debug": "^4.4.0",
    "glob": "^11.0.2",
    "nanostores": "^0.10.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./client": "./src/client/index.ts",
    "./config": "./src/config/index.ts",
    "./config-cli": "./src/config-cli/index.ts",
    "./context": "./src/context.ts",
    "./editing": "./src/editing/index.ts",
    "./middleware": "./src/middleware/index.ts",
    "./site": "./src/site/index.ts",
    "./tools": "./src/tools/index.ts",
    "./utils": "./src/utils/index.ts",
    "./components/Placeholder": "./src/components/Placeholder/index.ts"
  }
}
