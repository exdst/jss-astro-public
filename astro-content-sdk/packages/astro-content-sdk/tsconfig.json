{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "jsx": "react",
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["node_modules/@types", "../../node_modules/@types"],
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "tests"
  ]
}
