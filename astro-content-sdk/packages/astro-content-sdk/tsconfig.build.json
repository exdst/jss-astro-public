{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "types"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/tests",
    "src/**/*.test.ts",
    "src/**/*.astro.test.ts",
    "**/*.astro"
  ]
}
