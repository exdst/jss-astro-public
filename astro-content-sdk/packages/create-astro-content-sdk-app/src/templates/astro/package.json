{
  "name": "astro-content-sdk",
  "description": "Application utilizing Content SDK and Astro",
  "version": "0.0.21",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --serial astro:dev",
    "build": "npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build astro:build",
    "preview": "npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build astro:build astro:preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "astro:dev": "astro dev",
    "astro:build": "astro build",
    "astro:preview": "astro preview",
    "astro": "astro",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.2",
    "@exdst-sitecore-content-sdk/astro": "^0.0.21",
    "@sitecore-content-sdk/analytics-core": "^2.0.1",
    "@sitecore-content-sdk/events": "^2.0.1",
    "astro": "^6.1.1",
    "dotenv-flow": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sitecore-content-sdk/cli": "^2.0.1",
    "@types/node": "^24.12.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "npm-run-all2": "~8.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.2"
  }
}
